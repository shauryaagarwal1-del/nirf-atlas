# Copy this file to .env and fill in your own key. Never commit .env.
GEMINI_API_KEY=
# Optional: a second key, tried once when the first fails (e.g. its free quota is used up).
GEMINI_API_KEY_2=
# Optional: the Gemini model. Leave empty to use gemini-flash-latest (Google's newest Flash model).
GEMINI_MODEL=
